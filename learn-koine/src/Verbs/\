.menu-button-container-open {
  background-color: rgb(20, 250, 59);
  padding: 5px;
  height: 25px;
  width: 232px;
  display: flex;
  /* justify-content: center; */
  border: 2px solid rgb(7, 99, 4);
  transition: width 300ms, height 300ms;
  overflow: hidden;
}

.menu-button-container-closed {
  background-color: rgb(20, 250, 59);
  padding: 5px;
  height: 25px;
  width: 22px;
  display: flex;
  /* justify-content: center; */
  border: 2px solid rgb(7, 99, 4);
  transition: width 300ms, height 300ms;
  overflow: hidden;
}

.menu-options {
  padding-left: 5px;
  padding-bottom: 19px;
}

.menu-links {
   padding-left: 0.5em; 
  /* padding-bottom: 5px; */
  margin-bottom: 35px;
}

.menu-link {
  color: black;
  display: inline-block;
  font-size: 1rem;
  /* border: 1px red solid; */
  margin-bottom: 10px;
  white-space: nowrap;
}

.menu-container-open {
  /* height: 50px; */
  position: absolute;
  background-color: white;
  color: black;
  text-align: left;
  width: 245px;
  min-height: 100%;
  z-index: 6;
  border: 2px solid rgb(119, 119, 118);
  transition: width 300ms, height 300ms;
  overflow: hidden;
}

.menu-container-closed {
  /* height: 50px; */
  position: absolute;
  background-color: white;
  width: 36px;
  height: 39px;
  color: black;
  text-align: left;
  z-index: 3;
  border: 2px solid rgb(119, 119, 118);
  transition: width 300ms, height 300ms;
  overflow: hidden;
}

.verb-menu-options-closed h3 {
  font-size: 1em;
}

.verb-menu-options-open {
  box-sizing: border-box;
  font-size: 1em;
  position: fixed;
  z-index: 21;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: clamp(0.85rem, 2vw, 1.4rem);
  font-size: 0.76rem;
  width: min(900px, calc(100vw - 2rem));
  max-height: min(84vh, 760px);
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  touch-action: pan-y;
  color: #fff;
  text-align: center;
  background: #20242d;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 16px;
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4);
  transition: width 300ms, height 300ms;
}

.verb-menu-options-closed {
  position: fixed;
  z-index: 21;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 0px;
  font-size: 0.8em;
  width: 0px;
  height: 0px;
  visibility: hidden;
  pointer-events: none;
  overflow: hidden;
  transition: width 300ms, height 300ms, padding 300ms;
}

.verb-menu-options-closed .verb-menu-selection,
.verb-menu-options-closed .verb-menu-all-selection {
  opacity: 0;
}

.verb-menu-options-open .verb-menu-selection,
.verb-menu-options-open .verb-menu-all-selection {
  opacity: 1;
  transition: opacity 180ms ease 100ms;
}

.verb-options-backdrop {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  padding: 0;
  background: rgba(0, 0, 0, 0.58);
  border: 0;
  touch-action: none;
}

.verb-menu-options-open button {
  width: 100%;
}

.verb-options-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.55rem;
}

.verb-menu-categories {
  display: grid;
  font-size: 1em;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 130px), 1fr));
  gap: 0.5rem;
  justify-items: stretch;
  text-align: center;
  padding-bottom: 0.5rem;
}

.verb-menu-categories .verb-menu-all-selection { grid-column: 1 / -1; }

.verb-menu-group {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 0.55rem;
  background: #20242d;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 10px;
}

.verb-menu-group h3 { margin: 0 0 0.4rem; font-size: 0.9rem; }

.verb-menu-group .verb-menu-categories {
  flex: 1;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: repeat(3, minmax(1.8rem, auto)) minmax(1.8rem, auto);
  gap: 0.35rem;
  padding: 0;
}

.verb-menu-group .verb-menu-all-selection {
  grid-row: 4;
  grid-column: 1 / -1;
  align-self: end;
}

.verb-menu-group .verb-menu-selection,
.verb-menu-group .verb-menu-all-selection {
  box-sizing: border-box;
  padding: 0.35rem 0.2rem;
  font-size: 0.8rem;
}

.verb-menu-submit-card {
  display: flex;
  align-items: center;
  justify-content: center;
}

.verb-menu-actions {
  display: flex;
  gap: 0.55rem;
  width: 100%;
}

.verb-menu-submit-card .submit-button {
  flex: 1;
  width: auto;
  margin: 0;
  padding: 0.65rem 0.5rem;
  font-size: 0.9rem;
}

.verb-menu-submit-card .verb-menu-cancel {
  background: #343943;
}

.verb-menu-submit-card .submit-button:not(.verb-menu-cancel) {
  background: #0caf35;
}

.button-random {
  background-color: #282c34;
  border-radius: 10px;
  border-color: white;
  border-width: 0.5px;
  padding: 10px;
  color: white;
  font-weight: bold;
  margin-bottom: 1.5em;
  /* margin-left: 2em;*/
}

.verb-menu-selection {
  cursor: pointer;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 7px;
  padding: 0.6rem 0.4rem;
  -webkit-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

.chosen-option {
  background-color: #0c98a5;
  border-color: rgb(11, 92, 92);
  color: azure;
}

.chosen-all-option {
  background-color: #0c98a5;
  color: azure;
  border-color: #0c98a5;
}

.verb-menu-all-selection {
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 7px;
  padding: 0.6rem 0.4rem;
  cursor: pointer;
  -webkit-user-select: none;
  -ms-user-select: none;
  user-select: none;
}

.menu-button {
  border: none;
  color: #282c34;
  background: none;
  font-size: 0.9em;
  cursor: pointer;
  margin-bottom: 20px;
  white-space: nowrap;
}

.menu-toggle-button {
  background: none;
  border: none;
  font-size: large;
  cursor: pointer;
  width: 220px;
  text-align: center;
}

.verb-options-toggle {
  position: fixed;
  z-index: 11;
  left: calc(87% - 4.1em);
  bottom: 85px;
  width: 3.4em;
  height: 2.3em;
  padding: 0;
  background: transparent;
  border: 0;
  font-size: 1.2em;
  line-height: 0;
  cursor: pointer;
}

.verb-options-toggle img {
  display: block;
  width: 100%;
  height: 100%;
}

.verb-options-toggle:focus-visible {
  outline: 3px solid greenyellow;
  outline-offset: 3px;
}

.verb-sidebar-toggle {
  position: fixed;
  top: 8px;
  left: 8px;
  z-index: 13;
  min-width: 2.5rem;
  min-height: 2.5rem;
  color: #282c34;
  background: rgb(20, 250, 59);
  border: 2px solid rgb(7, 99, 4);
  border-radius: 5px;
  font-size: 1.2rem;
  cursor: pointer;
}

.verb-sidebar-content {
  position: fixed;
  z-index: 12;
  top: 0;
  left: 0;
  box-sizing: border-box;
  width: min(245px, calc(100vw - 3.5rem));
  min-height: 100vh;
  padding: 4rem 0.8rem 1rem;
  color: #20242d;
  background: #fff;
  border-right: 2px solid #777776;
  box-shadow: 8px 0 24px rgba(0, 0, 0, 0.25);
}

.verb-sidebar-content .auto-toggle {
  display: flex;
  align-items: flex-start;
  gap: 0.45rem;
  color: #20242d;
}

.verb-sidebar-content .menu-links { padding-left: 0.25rem; }

.submit-button {
  background-color: #282c34;
  border-radius: 10px;
  border-color: white;
  border-width: 0.5px;
  width: 100%;
  padding: 10px;
  color: white;
  font-weight: bold;
  margin: 1.5em 0px;
}

.submit-button:hover {
  cursor: pointer;
}

@media only screen and (max-width: 475px) {
  .verb-menu-options-open {
    font-size: 1.1em;
  }

  .verb-menu-options-closed {
    font-size: 1.1em;
  }

  .verb-menu-options-open h3 {
    font-size: 1em;
  }
}

@media (max-width: 620px) {
  .verb-options-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .verb-menu-options-open {
    max-height: 88vh;
    font-size: 0.76rem;
  }
}
